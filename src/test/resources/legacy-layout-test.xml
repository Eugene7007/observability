<?xml version="1.0" encoding="UTF-8"?>
<!-- формат прежнего Kafka-топика, выведенный в консоль: Kafka в тесте не нужна -->
<Configuration status="warn">
    <Appenders>
        <Console name="stdout" target="SYSTEM_OUT">
            <JsonTemplateLayout eventTemplateUri="classpath:lib-observability/layout-legacy-kafka.json" maxStringLength="5000">
                <EventTemplateAdditionalField key="application" value="svc"/>
            </JsonTemplateLayout>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="stdout"/>
        </Root>
    </Loggers>
</Configuration>
