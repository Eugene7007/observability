{
  "@timestamp": {
    "$resolver": "timestamp",
    "pattern": {
      "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
      "timeZone": "UTC"
    }
  },
  "level": {
    "$resolver": "level",
    "field": "name"
  },
  "message": {
    "$resolver": "maskedMessage"
  },
  "process.thread.name": {
    "$resolver": "thread",
    "field": "name"
  },
  "loggerName": {
    "$resolver": "logger",
    "field": "name"
  },
  "traceId": {
    "$resolver": "mdc",
    "key": "traceId",
    "stringified": true
  },
  "spanId": {
    "$resolver": "mdc",
    "key": "spanId",
    "stringified": true
  },
  "correlationId": {
    "$resolver": "mdc",
    "key": "correlationId",
    "stringified": true
  },
  "clientDeviceId": {
    "$resolver": "mdc",
    "key": "clientDeviceId",
    "stringified": true
  },
  "userGuid": {
    "$resolver": "mdc",
    "key": "userGuid",
    "stringified": true
  },
  "deviceId": {
    "$resolver": "mdc",
    "key": "deviceId",
    "stringified": true
  },
  "tags": {
    "$resolver": "ndc"
  },
  "httpFields": {
    "$resolver": "maskedMap",
    "prefix": "data.",
    "fields": "legacy"
  },
  "thrown": {
    "extendedStackTrace": {
      "$resolver": "maskedException",
      "field": "stackTrace",
      "truncationPoints": [
        "javax.servlet.http.HttpServlet.service",
        "jakarta.servlet.http.HttpServlet"
      ],
      "truncationSuffix": "... [truncated]"
    }
  }
}
