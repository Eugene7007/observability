<?xml version="1.0" encoding="UTF-8"?>
<!--
  lib-observability, режим STDOUT (целевой). Одна JSON-запись на строку в stdout, доставку в хранилище
  делает агент в кластере (Vector). Приложение ничего не знает о Kafka и Loki, поэтому их отказ
  не влияет на обработку запросов.

  Формат записи описан в layout-json.json: имена полей — OpenTelemetry semantic conventions, собственные поля
  библиотеки — под префиксом uz.kapitalbank. (README, «Формат логов»). Тела запросов и ответов библиотека сама обрезает до
  lib.observability.http-log.max-body-bytes (не больше 64 КБ) с меткой «...[truncated]», сообщения и стеки — до 32 КБ.
  maxStringLength (102400 символов) выше этих пределов с учётом роста тела при маскировании (худший случай —
  короткие значения, заменённые на «***», около ×1,5) и срабатывает только как страховка.
  maxStringLength — это ещё и начальный размер двух буферов log4j на каждый контекст записи, поэтому число
  контекстов ограничено пулом recyclerFactory="queue:capacity=16": удержание не больше ~5 МБ на сервис
  при любом числе ядер и потоков (без ограничения — до 37–78 МБ, ревью 2026-11-26).
  Уровни логгеров по-прежнему задаются через logging.level.* в application.yml.
-->
<Configuration status="warn" name="lib-observability-json">
    <Properties>
        <Property name="service.name">${spring:spring.application.name:-unknown}</Property>
    </Properties>

    <Appenders>
        <Console name="stdout" target="SYSTEM_OUT">
            <JsonTemplateLayout eventTemplateUri="classpath:lib-observability/layout-json.json" maxStringLength="102400"
                                recyclerFactory="queue:capacity=16">
                <EventTemplateAdditionalField key="service.name" value="${spring:spring.application.name:-unknown_service:java}"/>
                <EventTemplateAdditionalField key="service.version" value="${env:SERVICE_VERSION:-unknown}"/>
                <EventTemplateAdditionalField key="deployment.environment.name" value="${env:DEPLOYMENT_ENVIRONMENT:-unknown}"/>
                <EventTemplateAdditionalField key="uz.kapitalbank.log_library.name" value="${libobservability:name}"/>
                <EventTemplateAdditionalField key="uz.kapitalbank.log_library.version" value="${libobservability:version}"/>
            </JsonTemplateLayout>
        </Console>
    </Appenders>

    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="stdout"/>
        </Root>
    </Loggers>
</Configuration>
