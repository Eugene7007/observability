<?xml version="1.0" encoding="UTF-8"?>
<!--
  lib-observability, формат TEXT: читаемые строки для локального запуска (lib.observability.log.format=text).
  В кластере не используется: агент разбирает только JSON. Сообщения маскируются так же, как в JSON (%maskedMsg).
-->
<Configuration status="warn" name="lib-observability-text">
    <Appenders>
        <Console name="stdout" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %highlight{%-5p} [%X{traceId},%X{correlationId}] [%t] %c{1.} - %maskedMsg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="stdout"/>
        </Root>
    </Loggers>
</Configuration>
